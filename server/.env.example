DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rcsni_cost
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Random secret used to sign the session cookie -- generate your own, don't reuse this one.
SESSION_SECRET=change-me
# Session cookie name. Browsers scope cookies by domain+path, NOT by port -- if two
# sites both run on localhost (different ports) with the same cookie name, logging
# into one overwrites the other's session cookie in the browser. Give each site's
# .env a distinct value, e.g. plaridel.sid / villasis.sid. Defaults to connect.sid.
SESSION_COOKIE_NAME=connect.sid
